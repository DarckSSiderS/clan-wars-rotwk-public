{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "agentation": "node scripts/start-agentation-mcp.mjs",
    "dev": "vite",
    "test:unit": "node --test \"src/**/*.test.js\"",
    "test:ui": "playwright test",
    "check:api-fetch": "node scripts/check-api-fetch.mjs",
    "check:auth-storage": "node scripts/check-auth-storage.mjs",
    "check:i18n": "node scripts/check-localization.mjs && node scripts/check-unlocalized-ui.mjs",
    "check:archive": "node scripts/check-ennorath.mjs",
    "import:ennorath": "node scripts/import-ennorath.mjs",
    "build": "npm run check:i18n && node scripts/check-api-fetch.mjs && node scripts/check-auth-storage.mjs && npm run check:archive && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "axios": "^1.11.0",
    "bootstrap": "5.3.0",
    "framer-motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "agentation": "^3.0.2",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^7.1.2"
  }
}
