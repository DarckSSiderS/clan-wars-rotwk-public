[Unit]
Description=Clan Wars ROTWK FastAPI application
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=darcks
Group=darcks
WorkingDirectory=/home/clanwar/apps/clanwar/current
EnvironmentFile=/home/clanwar/apps/clanwar/shared/.env
ExecStart=/home/clanwar/apps/clanwar/current/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --no-access-log
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
