# Keep the real file at /etc/clanwar/backup.env with mode 0600.
DATABASE_URL=postgresql://clanwar@127.0.0.1:5432/clanwar
BACKUP_DESTINATION=/home/clanwar/backups/clanwar
RETENTION_DAYS=14
UPLOAD_DIR=/home/clanwar/apps/clanwar/current/frontend/public/images
REPLAY_STORAGE_DIR=/home/clanwar/apps/clanwar/shared/replays
MAP_PREVIEW_STORAGE_DIR=/home/clanwar/apps/clanwar/shared/map_previews
# Prefer PGPASSFILE in the systemd environment instead of embedding a password.
PGPASSFILE=/home/clanwar/apps/clanwar/shared/pgpass
