# Не храните этот файл как .env с настоящими паролями или токенами.
APP_NAME=ROTWK ClanWars
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=False

# PostgreSQL для production. Для изолированных локальных тестов допустима SQLite.
DATABASE_URL=postgresql://clanwar_user:replace-me@127.0.0.1:5432/clanwar_db

# Redis Pub/Sub синхронизирует сообщения и уведомления между API workers.
# Для локальной разработки можно оставить REDIS_URL пустым.
REDIS_URL=redis://127.0.0.1:6379/0
REALTIME_REDIS_CHANNEL=clanwar:realtime:v1
REDIS_CONNECT_TIMEOUT_SECONDS=2

# JWT: сгенерируйте новый секрет, например Python secrets.token_urlsafe(48).
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Локальные тестовые аккаунты. В production используйте безопасные отдельные значения.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-me
DEFAULT_ADMIN_EMAIL=admin@example.test
ADMIN_CLAN_USERNAME=darcks
ADMIN_CLAN_PASSWORD=replace-me
ADMIN_CLAN_EMAIL=clanwar@example.test
ADMIN_CLAN_NAME=Совет Тол-Фаласа

# Указывайте только реальные адреса frontend, а не wildcard.
CORS_ORIGINS=["http://localhost:3000"]

# OAuth BFME Arena. Включайте только после регистрации точного HTTPS callback.
BFME_OAUTH_ENABLED=False
BFME_OAUTH_CLIENT_ID=
BFME_OAUTH_CLIENT_SECRET=
BFME_OAUTH_REDIRECT_URI=https://example.com/api/v1/auth/arena/callback
BFME_OAUTH_AUTHORIZE_URL=https://bfmeladder.com/oauth2/authorize
BFME_OAUTH_TOKEN_URL=https://bfmeladder.com/oauth2/token
BFME_OAUTH_IDENTITY_URL=https://bfmeladder.com/oauth2/token
BFME_OAUTH_HTTP_TIMEOUT_SECONDS=10
BFME_OAUTH_STATE_TTL_SECONDS=600
BFME_PRIMARY_ADMIN_UUID=

# Серверные HttpOnly-сессии сайта.
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=rotwk_session
OAUTH_FLOW_COOKIE_NAME=rotwk_oauth_flow

# Файлы и worker.
UPLOAD_DIR=frontend/public/images
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=["image/jpeg", "image/png", "image/gif", "image/webp"]
SCHEDULER_UPDATE_INTERVAL=600
WAR_REPLAY_GRACE_MINUTES=5
# Set once when enabling the one-minute rule; never advance on later deploys.
# WAR_MIN_MATCH_DURATION_EFFECTIVE_AT=2026-09-21T21:00:00+00:00
WAR_PREVIOUS_MIN_MATCH_DURATION_SECONDS=120
WORKER_ALERT_WEBHOOK_URL=
WORKER_ALERT_TIMEOUT_SECONDS=5
ARENA_BACKFILL_JOBS_PER_CYCLE=2
ARENA_BACKFILL_MAX_PAGES=1000
ARENA_BACKFILL_RETRY_SECONDS=60

# BfME Ladder: импорт только поддерживаемых семейств патчей и режимов.
LADDER_API_BASE=https://bfmeladder.com/api/replays
LADDER_PUBLIC_API_BASE=https://bfmeladder.com/api/public/replays
LADDER_PUBLIC_API_ENABLED=False
LADDER_PUBLIC_API_TOKEN=
LADDER_ARENA_ID=2bd291d4-a624-481d-af9b-3a63ea9effa7
LADDER_GAME=RotWK
LADDER_GAMEMODES="1 versus 1,2 versus 2,3 versus 3,4 versus 4"
LADDER_SYNC_WINDOW_HOURS=12
LADDER_SYNC_OVERLAP_MINUTES=15
LADDER_API_SCAN_LIMIT=500
REPLAY_STORAGE_DIR=replays
MAP_PREVIEW_STORAGE_DIR=map_previews
